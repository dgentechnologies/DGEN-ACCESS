# ─── Frontend (Client-side) Firebase Config ──────────────────────────────────
# These are safe to expose publicly (they identify the project, not authenticate)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dgen-superadmin.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dgen-superadmin
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dgen-superadmin.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Named Firestore database ID (the database named "access" in your Firebase project)
NEXT_PUBLIC_FIREBASE_ACCESS_DATABASE_ID=access

# ─── Firebase Admin SDK (Server-side) ────────────────────────────────────────
# Required for all API routes. Get these from Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key
FIREBASE_ACCESS_PROJECT_ID=dgen-superadmin
FIREBASE_ACCESS_CLIENT_EMAIL=firebase-adminsdk-fbsvc@dgen-superadmin.iam.gserviceaccount.com
FIREBASE_ACCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# ↑ Paste your full private key above, keeping the \n escape sequences exactly as shown.

# Named Firestore database ID (must match NEXT_PUBLIC_FIREBASE_ACCESS_DATABASE_ID)
FIREBASE_ACCESS_DATABASE_ID=access

# ─── Firebase Realtime Database (RTDB) ───────────────────────────────────────
# Used by the ESP32 for card verification and access logging.
# Find this in Firebase Console -> Realtime Database -> copy the URL at the top.
# Format: https://<project-id>-default-rtdb.firebaseio.com
FIREBASE_ACCESS_DATABASE_URL=https://dgen-superadmin-default-rtdb.firebaseio.com

