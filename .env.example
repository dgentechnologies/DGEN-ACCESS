# Firebase Admin SDK (Server-side) - Required for API routes
FIREBASE_PROJECT_ID="dgen-access"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@dgen-access.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL="https://dgen-access-default-rtdb.asia-southeast1.firebasedatabase.app"

# Note: The frontend Firebase config is hardcoded in src/lib/firebase.js
# You can optionally move it to environment variables if needed:
# NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# etc...
