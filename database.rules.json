{
  "rules": {
    ".read": "auth != null || true",
    ".write": "auth != null || true",
    "$comment": [
      "Note: These rules are permissive for ESP32 integration and admin dashboard access.",
      "For production environments, consider:",
      "1. Implementing Firebase Authentication with custom tokens",
      "2. Using Firebase App Check to verify requests",
      "3. Implementing IP allowlisting",
      "4. Setting up API key validation in your API routes",
      "5. Using Firebase Security Rules with stricter conditions"
    ],
    "users": {
      ".read": true,
      ".write": true,
      "$userId": {
        ".validate": "newData.hasChildren(['name', 'role', 'status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "role": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'Active' || newData.val() === 'Banned')"
        },
        "isSuperAdmin": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        }
      }
    },
    "logs": {
      ".read": true,
      ".write": true,
      "$logId": {
        ".validate": "newData.hasChildren(['userId', 'userName', 'timestamp', 'status'])",
        "userId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'granted' || newData.val() === 'denied')"
        },
        "message": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
