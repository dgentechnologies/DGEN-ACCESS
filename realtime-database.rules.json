{
  "rules": {
    "access": {
      "rfid_cards": {
        ".read": true,
        ".write": false,
        "$userId": {
          ".validate": "newData.hasChildren(['userId','name','role','status','cardText'])"
        }
      },
      "access_logs": {
        ".read": false,
        ".write": true,
        "$logId": {
          ".validate": "newData.hasChildren(['cardId','userId','name','status','timestamp','deviceId','method'])"
        }
      },
      "remote_unlock": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['requested','triggeredBy','requestedAt'])"
      },
      "devices": {
        ".read": true,
        ".write": true,
        "$deviceId": {
          ".validate": "newData.hasChildren(['name','online','lastSeen'])"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
